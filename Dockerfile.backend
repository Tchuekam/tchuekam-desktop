FROM node:22-bookworm-slim AS node_runtime

FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies (Node 22 copied from node_runtime avoids 400+ Debian npm packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Copy requirements and install
COPY requirements-backend.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt

# Copy application code, agent/gateway modules, and prebuilt apps/desktop/dist-web
COPY . .

# Install the package so hermes CLI and entrypoints are available
RUN pip install --no-cache-dir -e .

# Environment defaults
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production
ENV PORT=8000
ENV HERMES_DASHBOARD_INSECURE=1
ENV HERMES_DASHBOARD_TUI=1
ENV HERMES_HOME=/app/data
ENV HERMES_WEB_DIST=/app/apps/desktop/dist-web
ENV HERMES_SKIP_NODE_BOOTSTRAP=1

RUN mkdir -p /app/data

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start command
CMD ["sh", "-c", "python -m hermes_cli.main dashboard --host 0.0.0.0 --port ${PORT:-8000} --insecure --skip-build --no-open"]
