# TchueKAM SaaS API (tchuekam_backend, FastAPI) — production image.
#
# Serves the multi-tenant API under gunicorn with N UvicornWorkers. The image
# previously defaulted to `hermes_cli.main dashboard`, the single-operator
# desktop dashboard, which spawns a PTY-backed TUI child per session and never
# served the API. Worker and connection-pool sizing: gunicorn.conf.py and
# docs/CAPACITY.md.

FROM python:3.11-slim

WORKDIR /app

# curl is kept for the HEALTHCHECK below; the rest are needed by psycopg's
# binary wheel and by git-based dependency resolution.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Dependencies are copied and installed before the application code so that a
# code change does not invalidate the (slow) dependency layer.
COPY requirements-backend.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt

COPY . .

# Create non-root runtime user.
#
# /app/metrics holds the Prometheus multiprocess files that every worker
# writes to, so it must be writable by the runtime user — without it
# /metrics would report a single worker's numbers (see core/metrics.py).
RUN useradd --create-home --shell /bin/sh appuser \
    && mkdir -p /app/data /app/metrics \
    && chown -R appuser:appuser /app/data /app/metrics

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production \
    PORT=8000 \
    PROMETHEUS_MULTIPROC_DIR=/app/metrics

USER appuser

EXPOSE 8000

# Probes the readiness endpoint, not /health: /readyz also fails when the
# database is unreachable or the instance is draining, which is exactly when
# traffic should stop being routed here. start-period covers migrations plus
# worker boot.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:${PORT:-8000}/readyz || exit 1

# Migrations run before the server starts. scripts/db_migrate.py takes a
# Postgres advisory lock, so several instances starting at once serialise:
# one migrates, the others wait and boot on the migrated schema. A failed
# migration exits non-zero and the container never serves a wrong schema.
CMD ["sh", "-c", "python scripts/db_migrate.py && exec gunicorn -c gunicorn.conf.py tchuekam_backend.main:app"]
