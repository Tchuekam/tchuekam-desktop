FROM node:22-bookworm-slim AS webapp_builder

WORKDIR /build

ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

COPY package.json package-lock.json ./
COPY apps/desktop/package.json ./apps/desktop/package.json
COPY apps/shared/package.json ./apps/shared/package.json
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY apps/bootstrap-installer/package.json ./apps/bootstrap-installer/package.json
COPY web/package.json ./web/package.json

RUN npm install --prefer-offline --no-audit --no-fund --workspace apps/desktop --include-workspace-root

COPY apps/desktop ./apps/desktop
COPY apps/shared ./apps/shared

ARG VITE_AUTH_PORTAL_URL=https://tchuekam-auth-production.up.railway.app
ARG VITE_SUPABASE_URL=https://fzoiiusuqvjhwivstbyb.supabase.co
ARG VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ6b2lpdXN1cXZqaHdpdnN0YnliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQyNDgxNjUsImV4cCI6MjA5OTgyNDE2NX0.CH6Z7CxPaRxND2fivpcGu42RFmo8uxyBeeoeTuGEPCI
ARG VITE_HERMES_DEMO=1
ARG VITE_HERMES_APP_VERSION=0.15.3

ENV VITE_AUTH_PORTAL_URL=$VITE_AUTH_PORTAL_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_HERMES_DEMO=$VITE_HERMES_DEMO
ENV VITE_HERMES_APP_VERSION=$VITE_HERMES_APP_VERSION

RUN rm -rf apps/desktop/dist-web && npm run build:web --workspace apps/desktop

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    nodejs \
    npm \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements-backend.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt

# Copy application code and agent/gateway modules
COPY . .

# Overlay freshly built apps/desktop/dist-web (includes Supabase web auth handoff)
RUN rm -rf /app/apps/desktop/dist-web
COPY --from=webapp_builder /build/apps/desktop/dist-web /app/apps/desktop/dist-web

# Install the package so hermes CLI and entrypoints are available
RUN pip install --no-cache-dir -e .

# Environment defaults
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production
ENV PORT=8000
ENV HERMES_DASHBOARD_INSECURE=1
ENV HERMES_DASHBOARD_TUI=1
ENV HERMES_HOME=/app/data

RUN mkdir -p /app/data

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start command
CMD ["sh", "-c", "python -m hermes_cli.main dashboard --host 0.0.0.0 --port ${PORT:-8000} --insecure --skip-build --no-open"]
