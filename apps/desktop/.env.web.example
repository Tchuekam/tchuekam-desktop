# Web build configuration. Copy to .env.local (ignored by git) for local work;
# on a host like Vercel, set these as project environment variables instead.
#
# Everything here is read at BUILD time and inlined into the bundle, so a
# change needs a rebuild — and anything here is readable by anyone who opens
# the page. Never put a model provider key in this file.

# Base URL of the TchuekaM agent backend. Required: the gateway needs a
# WebSocket, which host-level HTTP rewrites do not forward, so the browser
# talks to the backend directly rather than through a same-origin /api path.
VITE_HERMES_API_URL=https://your-service.onrender.com

# Dashboard session token. Must equal HERMES_DASHBOARD_SESSION_TOKEN on the
# backend. The browser sends it as a header on /api/* and as ?token= on the
# gateway WebSocket.
#
# This is shipped in the bundle, so treat it as public: it identifies the
# deployment, it does not protect it. What protects a public deployment is the
# toolset configuration on the backend — see WEB.md.
VITE_HERMES_TOKEN=change-me

# Version string shown in the app. Optional.
VITE_HERMES_APP_VERSION=0.15.3-web

# Demo lock-down. '1' (the default) hides settings, profiles, messaging,
# automation, the terminal and the file browser — every surface that
# configures the host rather than the conversation. Set to '0' only for a
# deployment that just one trusted person can reach.
VITE_HERMES_DEMO=1
